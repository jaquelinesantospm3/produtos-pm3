{
  "name": "produtos-pm3",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "tipos": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "banco:local": "wrangler d1 migrations apply produtos-pm3 --local",
    "banco:producao": "wrangler d1 migrations apply produtos-pm3 --remote"
  },
  "dependencies": {
    "lucide-react": "^0.460.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@opennextjs/cloudflare": "^1.20.6",
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "wrangler": "^4.131.1"
  }
}
